# ==============================================================================
# SAAMX Phase 6 Production Environment Variables Template
# Target: Railway Web Service + Supabase PostgreSQL + Firebase Realtime Database
# ==============================================================================

# 1. Authoritative Supabase PostgreSQL Database (Session Mode)
# Port 5432 is required for pessimistic row locks (SELECT ... FOR UPDATE) and prepared statements.
DATABASE_URL=postgresql://postgres.avkvyaslebvvrhcdzibn:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
PG_POOL_MAX=30
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=10000

# 2. Server Runtime & Security
PORT=3000
NODE_ENV=production
SAAMX_AUTH_SECRET=YOUR_64_CHAR_HEX_SECRET
CORS_ORIGIN=https://saamx.in,https://www.saamx.in,https://fmos-a6573.web.app

# 3. Live Data Mirror (Firebase Realtime Database)
FIREBASE_DATABASE_URL=https://fmos-a6573-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# 4. Frontend Environment Variables (Vite build-time)
VITE_API_URL=https://api.saamx.in
VITE_WS_HOST=wss://api.saamx.in
VITE_FIREBASE_DATABASE_URL=https://fmos-a6573-default-rtdb.asia-southeast1.firebasedatabase.app
