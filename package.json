{
  "name": "fms-platform",
  "version": "1.0.0",
  "description": "Financial Market Simulation Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "server": "node --max-old-space-size=3072 server.js",
    "build": "vite build",
    "preview": "vite preview",
    "dev": "vite",
    "start": "node --max-old-space-size=3072 server.js",
    "test:full": "node test-full-audit.js",
    "test:master": "node test-e2e-master-runner.js",
    "test:milestones": "node test-milestone-m0-defects.js && node test-milestone-m1-order-lifecycle.js && node test-milestone-m2-fx-reserves.js && node test-milestone-m3-accounting.js && node test-milestone-m1-news-intelligence.js",
    "test:queues": "node test-milestone-phase-c-queues.js && node test-milestone-phase-d-fx-queue.js",
    "test:advisory": "node test-milestone-phase-e-broker.js",
    "test:training": "node test-milestone-phase-f-training.js",
    "simulate": "node scripts/simulate_live_event_drill.js",
    "verify:hash": "node -e \"const c=require('crypto'),f=require('fs');console.log(c.createHash('sha256').update(f.readFileSync('state.json')).digest('hex'));\""
  },
  "dependencies": {
    "@vercel/node": "^5.8.23",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11",
    "xlsx": "^0.18.5"
  }
}
